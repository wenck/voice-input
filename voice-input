#!/usr/bin/env python3
# voice-input: 本地离线中文语音输入（SenseVoice + Silero VAD）
# Linux 走 IBus 引擎 + Super+Z；macOS 走 Quartz 事件监听 + Cmd+Z。
# 快捷键开始听写，再按一次结束并回填文本，Esc 取消。
import os
import sys

# 自动切到同目录 venv 解释器（systemd 与命令行都走这里）
_HERE = os.path.dirname(os.path.abspath(__file__))
_VENV_PY = os.path.join(_HERE, 'venv', 'bin', 'python')
# venv/bin/python 是指向系统 python 的软链，比较 realpath 会误判，须比路径本身
if os.path.exists(_VENV_PY) and sys.executable != _VENV_PY:
    os.execv(_VENV_PY, [_VENV_PY] + sys.argv)

import queue
import re
import signal
import string
import threading
import time

import numpy as np

IS_DARWIN = sys.platform == 'darwin'

MODELS = os.environ.get('VOICE_INPUT_MODELS',
                        os.path.expanduser('~/src/sub-live-v2/models'))
_SV_DEFAULT = os.path.expanduser(
    '~/.cache/asr_models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17'
) if IS_DARWIN else os.path.join(MODELS, 'sensevoice')
_VAD_DEFAULT = os.path.expanduser('~/.cache/asr_models/silero_vad.onnx') \
    if IS_DARWIN else os.path.join(MODELS, 'silero-vad', 'silero_vad.onnx')
SENSEVOICE = os.environ.get('VOICE_INPUT_SENSEVOICE', _SV_DEFAULT)
VAD_MODEL = os.environ.get('VOICE_INPUT_VAD', _VAD_DEFAULT)
LANG = os.environ.get('VOICE_INPUT_LANG', 'zh')
TEST_WAV = os.environ.get('VOICE_INPUT_TEST_WAV', '')
DEBUG = os.environ.get('VOICE_INPUT_DEBUG', '') == '1'

ENGINE_NAME = 'voice-input'
_HOTKEY = 'Cmd+Z' if IS_DARWIN else 'Super+Z'
AUX_LISTENING = f'正在听… {_HOTKEY} 结束 / Esc 取消'
AUX_FINISHING = '识别中…'

SAMPLE_RATE = 16000
WIN = 512  # Silero VAD 窗口（32ms @16k）
LEAD_WINS = int(0.2 * SAMPLE_RATE / WIN)    # 句首预录 0.2s
PAUSE_WINS = int(0.6 * SAMPLE_RATE / WIN)   # 0.6s 静音切句
MIN_WINS = int(0.3 * SAMPLE_RATE / WIN)     # 最短语音 0.3s
MAX_WINS = int(20 * SAMPLE_RATE / WIN)      # 单句上限 20s
IDLE_STOP_WINS = int(20 * SAMPLE_RATE / WIN)  # 20s 一直无语音自动停

_PAD = np.zeros(8000, dtype=np.float32)  # 段前后各补 0.5s 静音

_PUNCT_ONLY = set(string.punctuation + '，。！？、；：‘’“”…—·《》【】〈〉％＃＆＊＠～')


def log(msg):
    print(f'[voice-input] {msg}', file=sys.stderr, flush=True)


def load_vad():
    import sherpa_onnx
    cfg = sherpa_onnx.VadModelConfig()
    cfg.silero_vad.model = VAD_MODEL
    cfg.silero_vad.threshold = 0.5  # 近场麦克风，无需 AGC
    cfg.sample_rate = SAMPLE_RATE
    vad = sherpa_onnx.VadModel.create(cfg)
    return vad


def load_recognizer():
    import sherpa_onnx
    lang = LANG if LANG in ('zh', 'en', 'ja', 'ko', 'yue') else 'auto'
    return sherpa_onnx.OfflineRecognizer.from_sense_voice(
        model=os.path.join(SENSEVOICE, 'model.int8.onnx'),
        tokens=os.path.join(SENSEVOICE, 'tokens.txt'),
        num_threads=4, language=lang, use_itn=True)


def recognize(recognizer, audio16):
    s = recognizer.create_stream()
    # 前后补 0.5s 静音，避免贪心解码在紧贴语音的切片上丢字
    s.accept_waveform(SAMPLE_RATE, np.concatenate([_PAD, audio16, _PAD]))
    recognizer.decode_stream(s)
    return s.result.text.strip()


def clean_text(text):
    text = re.sub(r'\s+', '', text) if re.search(r'[一-鿿]', text) else text.strip()
    if not text:
        return ''
    # 丢弃纯标点结果
    if all(c in _PUNCT_ONLY for c in text):
        return ''
    return text


class Segmenter:
    # VAD 分段状态机：窗口流入 -> 检出语音段 -> 交回调
    def __init__(self, vad, on_segment):
        self.vad = vad
        self.on_segment = on_segment
        self.reset()
        self.idle_wins = 0  # 会话开始以来连续无语音窗口数

    def reset(self):
        self.lead = []
        self.chunks = []
        self.voiced = 0
        self.silence = 0
        self.discard = False

    def feed(self, window):
        is_speech = bool(self.vad.is_speech(window))
        if is_speech:
            self.chunks.append(window)
            self.voiced += 1
            self.silence = 0
            self.idle_wins = 0
        else:
            if self.voiced > 0:
                self.chunks.append(window)
                self.silence += 1
            else:
                self.lead.append(window)
                if len(self.lead) > LEAD_WINS:
                    self.lead.pop(0)
                self.idle_wins += 1

        done = (self.voiced >= MIN_WINS and self.silence >= PAUSE_WINS) \
            or len(self.chunks) >= MAX_WINS
        if done:
            self._emit()

    def flush(self):
        # 停止时冲刷在途的半句
        if self.chunks:
            self._emit()

    def _emit(self):
        if not self.discard:
            audio16 = np.concatenate(self.lead + self.chunks)
            if self.voiced >= MIN_WINS:
                self.on_segment(audio16)
        self.reset()


# ---------------- selftest：无 IBus，跑完整 VAD+ASR 分段 ----------------

def read_wav_16k(path):
    import wave
    w = wave.open(path)
    if w.getframerate() != SAMPLE_RATE or w.getnchannels() != 1 or w.getsampwidth() != 2:
        raise SystemExit(f'{path}: 只支持 16kHz 单声道 s16 wav'
                         f'（实际 {w.getframerate()}Hz/{w.getnchannels()}ch/{w.getsampwidth()}B）')
    frames = w.readframes(w.getnframes())
    return np.frombuffer(frames, dtype=np.int16).astype(np.float32) / 32768.0


def selftest(path):
    vad = load_vad()
    rec = load_recognizer()
    segments = []

    def on_seg(audio16):
        t0 = time.time()
        text = clean_text(recognize(rec, audio16))
        dt = time.time() - t0
        segments.append((len(audio16) / SAMPLE_RATE, text, dt))

    seg = Segmenter(vad, on_seg)
    audio = read_wav_16k(path)
    for i in range(0, len(audio) - WIN + 1, WIN):
        seg.feed(audio[i:i + WIN])
    seg.flush()
    for dur, text, dt in segments:
        print(f'[{dur:5.2f}s | asr {dt:.2f}s] {text}')
    print(f'{len(segments)} segment(s)')
    return 0


# ---------------- IBus 服务（Linux） ----------------

def run_service_linux():
    import gi
    gi.require_version('IBus', '1.0')
    from gi.repository import IBus, GLib, GObject
    import sounddevice as sd

    vad = load_vad()
    recognizer = load_recognizer()
    log('models loaded')

    class VoiceInputEngine(IBus.Engine):
        __gtype_name__ = 'VoiceInputEngine'

        def do_enable(self):
            app.engine_enabled(self)

        def do_disable(self):
            app.engine_disabled(self)

        def do_focus_in(self):
            app.engine_focus_in(self)

        def do_focus_out(self):
            app.engine_focus_out(self)

        def do_process_key_event(self, keyval, keycode, state):
            pressed = not (state & IBus.ModifierType.RELEASE_MASK)
            if pressed and keyval == IBus.KEY_Escape:
                if app.on_escape():
                    return True
            return False

    class App:
        def __init__(self):
            self.bus = IBus.Bus()
            self.bus.connect('disconnected', self._on_disconnected)
            if not self.bus.is_connected():
                log('ibus-daemon 未连接，退出等待 systemd 重启')
                os._exit(3)
            self.state = 'idle'  # idle | listening | finishing
            self.prev_engine = 'rime'
            self.restore = True   # 结束时是否回切（外部禁用则不回切）
            self.engine = None      # 当前已 enable 的引擎实例
            self.engine_has_focus = False
            self.aux_pending = None
            self.stream = None
            self.audio_q = queue.Queue()
            self.worker_stop = threading.Event()
            self.worker_flush = threading.Event()
            self.stop_req = threading.Event()
            self.segmenter = None

        # ---- IBus 连接 ----
        def _set_engine(self, name):
            # 必须用 async 版本：sync 版会阻塞主循环，
            # 导致 daemon 的 create_engine 请求超时（实测 ~15s 才 enable）
            self.bus.set_global_engine_async(
                name, -1, None, self._on_set_engine, None)

        def _on_set_engine(self, bus, res, _):
            try:
                bus.set_global_engine_async_finish(res)
            except Exception as e:
                log(f'set_global_engine 失败: {e}')

        def _on_disconnected(self, bus):
            log('ibus-daemon 断开，退出等待 systemd 重启')
            os._exit(3)

        # ---- 引擎实例生命周期（主线程） ----
        def engine_enabled(self, eng):
            self.engine = eng
            self.engine_has_focus = True
            if self.aux_pending is not None:
                self._show_aux(self.aux_pending)
                self.aux_pending = None
            log('engine enabled')

        def engine_disabled(self, eng):
            if self.engine is eng:
                self.engine = None
            self.engine_has_focus = False
            log('engine disabled')
            # 外部切走（如 Super+Space）：丢音、丢状态、不回切
            if self.state != 'idle':
                self._abort_session(restore=False)

        def engine_focus_in(self, eng):
            self.engine_has_focus = True

        def engine_focus_out(self, eng):
            self.engine_has_focus = False

        # ---- 状态机 ----
        def toggle(self):
            # 信号回调必须返回 True，否则 GLib 触发一次就移除 handler，
            # 第二次 SIGUSR1 走默认动作直接杀进程（实测踩坑）
            if self.state == 'idle':
                self._start()
            elif self.state == 'listening':
                self._stop(flush=True)
            else:
                log('finishing 中，忽略切换信号')
            return True

        def _start(self):
            try:
                cur = self.bus.get_global_engine()
                name = cur.get_name() if cur else None
            except Exception as e:
                log(f'get_global_engine 失败: {e}')
                name = None
            self.prev_engine = name if name and name != ENGINE_NAME else 'rime'
            self.restore = True
            log(f'start: prev_engine={self.prev_engine}')
            self._set_engine(ENGINE_NAME)
            self.state = 'listening'
            self.stop_req.clear()
            self.worker_stop.clear()
            self.worker_flush.clear()
            # 每个会话用新队列：旧流迟到的回调不会把残音喂进新会话
            self.audio_q = queue.Queue()
            q = self.audio_q
            self.segmenter = Segmenter(vad, self._on_segment)
            threading.Thread(target=self._audio_worker,
                             args=(self.segmenter, q), daemon=True).start()
            if TEST_WAV:
                threading.Thread(target=self._feed_wav, args=(q,),
                                 daemon=True).start()
            else:
                def cb(indata, frames, t, status):
                    q.put(indata[:, 0].copy())
                try:
                    self.stream = sd.InputStream(
                        samplerate=SAMPLE_RATE, channels=1,
                        dtype='float32', blocksize=WIN,
                        callback=cb)
                    self.stream.start()
                except Exception as e:
                    log(f'麦克风打开失败: {e}')
                    self._abort_session(restore=True)
                    return
            self._aux(AUX_LISTENING)

        def _stop(self, flush):
            log(f'stop: flush={flush}')
            if self.state == 'listening':
                self.state = 'finishing'
            self._close_mic()
            if flush:
                self._aux(AUX_FINISHING)
                self.worker_flush.set()
            else:
                self._finish_now()

        def _abort_session(self, restore):
            # 取消/外部禁用：丢弃在途语音，停止一切
            self.restore = restore
            if self.segmenter:
                self.segmenter.discard = True
            self._close_mic()
            if self.state != 'idle':
                self.state = 'finishing'
                self.worker_flush.set()  # 让 worker 退出后回调 _finish_now

        def _close_mic(self):
            if self.stream is not None:
                try:
                    self.stream.stop()
                    self.stream.close()
                except Exception:
                    pass
                self.stream = None

        def _finish_now(self):
            # 所有提交都已通过 idle_add 排队完成，这里最后恢复
            self.state = 'idle'
            self.worker_stop.set()
            self._hide_aux()
            if self.restore and self.prev_engine:
                log(f'restore engine -> {self.prev_engine}')
                self._set_engine(self.prev_engine)

        def on_escape(self):
            if self.state == 'listening':
                log('Esc 取消')
                self._abort_session(restore=True)
                return True
            return False

        # ---- aux 文本（主线程） ----
        def _aux(self, s):
            if self.engine is not None:
                self._show_aux(s)
            else:
                self.aux_pending = s

        def _show_aux(self, s):
            if self.engine is not None:
                self.engine.update_auxiliary_text(
                    IBus.Text.new_from_string(s), True)

        def _hide_aux(self):
            if self.engine is not None:
                self.engine.hide_auxiliary_text()
            self.aux_pending = None

        # ---- 音频回调与 worker（非主线程，禁止直接调 IBus） ----
        def _feed_wav(self, q):
            # VOICE_INPUT_TEST_WAV：按实时节奏喂文件，随后持续喂静音
            audio = read_wav_16k(TEST_WAV)
            silence = np.zeros(WIN, dtype=np.float32)
            i = 0
            while not self.worker_stop.is_set() and not self.worker_flush.is_set():
                if i + WIN <= len(audio):
                    w = audio[i:i + WIN]
                    i += WIN
                else:
                    w = silence
                q.put(w.copy())
                time.sleep(WIN / SAMPLE_RATE)

        def _audio_worker(self, seg, q):
            # 队列绑定会话：旧音频流的迟到回调喂不进本会话
            while not self.worker_stop.is_set():
                try:
                    w = q.get(timeout=0.15)
                except queue.Empty:
                    # 真麦模式队列会在关麦后一直空，flush/stop 都要在这里检查，
                    # 否则 worker 空转、_finish_now 永远排不上（实测踩坑）
                    if self.worker_stop.is_set() or self.worker_flush.is_set():
                        break
                    continue
                if not seg.discard:
                    seg.feed(w)
                if self.worker_flush.is_set():
                    break
                if seg.idle_wins >= IDLE_STOP_WINS and seg.voiced == 0:
                    log('20s 无语音，自动停止')
                    GLib.idle_add(self._stop, True)
                    break
            # 冲刷：识别耗时期间mic仍在进队列，先把积压窗口喂完再 flush，
            # 否则按下停止前的尾音会被丢弃；discard（Esc/外部禁用）则只排空
            while True:
                try:
                    w = q.get_nowait()
                except queue.Empty:
                    break
                if not seg.discard:
                    seg.feed(w)
            seg.flush()
            GLib.idle_add(self._finish_now)

        def _on_segment(self, audio16):
            dur = len(audio16) / SAMPLE_RATE
            t0 = time.time()
            try:
                text = clean_text(recognize(recognizer, audio16))
            except Exception as e:
                log(f'识别错误: {e}')
                return
            log(f'segment {dur:.2f}s -> asr {time.time()-t0:.2f}s')
            if DEBUG and text:
                log(f'[debug] text: {text}')
            if text:
                GLib.idle_add(self._commit, text)

        def _commit(self, text):
            # 主线程：交给当前已聚焦的引擎实例上屏
            eng = self.engine
            if eng is not None and self.engine_has_focus:
                eng.commit_text(IBus.Text.new_from_string(text))
            else:
                log('引擎未聚焦，丢弃提交')
            return False

    app = App()

    component = IBus.Component(
        name='org.local.VoiceInput',
        description='Local offline Chinese voice input',
        version='1.0', license='MIT',
        author='local', homepage='', command_line='', textdomain='')
    desc = IBus.EngineDesc(
        name=ENGINE_NAME, longname='语音输入',
        description='本地离线中文语音输入（SenseVoice）',
        language='zh', license='MIT', author='local',
        icon='audio-input-microphone', layout='default')
    component.add_engine(desc)

    factory = IBus.Factory.new(app.bus.get_connection())
    factory.add_engine(ENGINE_NAME,
                       GObject.type_from_name('VoiceInputEngine'))
    app.bus.register_component(component)

    try:
        from gi.repository import GLibUnix
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, app.toggle)
    except Exception:
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, app.toggle)
    log('ready (SIGUSR1 toggle)')
    GLib.MainLoop().run()
    return 0


# ---------------- macOS 服务（Quartz 事件监听 + 合成键盘事件回填） ----------------

def run_service_macos():
    import Quartz
    import sounddevice as sd
    from Cocoa import (NSApplication, NSStatusBar, NSMenu, NSMenuItem,
                       NSSound, NSObject, NSTimer, NSURL, NSWorkspace,
                       NSRunningApplication,
                       NSVariableStatusItemLength,
                       NSApplicationActivationPolicyAccessory)
    from PyObjCTools import AppHelper
    try:
        from ApplicationServices import (
            AXUIElementCreateSystemWide, AXUIElementCopyAttributeValue,
            AXUIElementGetPid, AXIsProcessTrustedWithOptions,
            kAXTrustedCheckOptionPrompt)
    except ImportError:
        AXUIElementCreateSystemWide = None
        AXIsProcessTrustedWithOptions = None

    vad = load_vad()
    recognizer = load_recognizer()
    log('models loaded')

    KEY_Z = 6        # kVK_ANSI_Z
    KEY_ESC = 53     # kVK_Escape
    OTHER_MODS = (Quartz.kCGEventFlagMaskShift |
                  Quartz.kCGEventFlagMaskControl |
                  Quartz.kCGEventFlagMaskAlternate)

    class App:
        def __init__(self):
            self.state = 'idle'  # idle | listening | finishing
            self.stream = None
            self.audio_q = queue.Queue()
            self.worker_stop = threading.Event()
            self.worker_flush = threading.Event()
            self.segmenter = None
            self.status_item = None
            self.hotkey_ready = False
            self.snd_start = NSSound.alloc().initWithContentsOfFile_byReference_(
                '/System/Library/Sounds/Tink.aiff', True)
            self.snd_stop = NSSound.alloc().initWithContentsOfFile_byReference_(
                '/System/Library/Sounds/Pop.aiff', True)

        def _play(self, snd):
            # NSSound.play() 在远程桌面会话里会卡死主线程，放后台线程
            threading.Thread(target=snd.play, daemon=True).start()

        # ---- 状态栏（主线程） ----
        def _status(self, s):
            if self.status_item is not None:
                self.status_item.button().setTitle_(s)

        # ---- 状态机（全部经 callAfter 落到主线程） ----
        def toggle(self):
            if self.state == 'idle':
                self._start()
            elif self.state == 'listening':
                self._stop(flush=True)
            else:
                log('finishing 中，忽略切换信号')

        def _start(self):
            self.state = 'listening'
            self.worker_stop.clear()
            self.worker_flush.clear()
            # 每个会话用新队列：旧流迟到的回调不会把残音喂进新会话
            self.audio_q = queue.Queue()
            q = self.audio_q
            self.segmenter = Segmenter(vad, self._on_segment)
            threading.Thread(target=self._audio_worker,
                             args=(self.segmenter, q), daemon=True).start()
            if TEST_WAV:
                threading.Thread(target=self._feed_wav, args=(q,),
                                 daemon=True).start()
            else:
                def cb(indata, frames, t, status):
                    q.put(indata[:, 0].copy())
                result = []

                def open_mic():
                    # 无麦克风权限时 InputStream 可能永久阻塞而不是报错
                    # （实测远程桌面会话卡死主线程），限 3s 超时
                    try:
                        st = sd.InputStream(
                            samplerate=SAMPLE_RATE, channels=1,
                            dtype='float32', blocksize=WIN,
                            callback=cb)
                        st.start()
                        with lock:
                            if timed_out:
                                # 超时后才打开成功（如授权弹窗刚被点允许）：
                                # 本会话已放弃，立即关闭，避免麦克风被孤儿流占用
                                st.stop()
                                st.close()
                                return
                            result.append(st)
                    except Exception as e:
                        result.append(e)

                lock = threading.Lock()
                timed_out = False
                t = threading.Thread(target=open_mic, daemon=True)
                t.start()
                t.join(3)
                with lock:
                    timed_out = not result
                if not result or isinstance(result[0], Exception):
                    log(f'麦克风打开失败: {"超时" if not result else result[0]}')
                    self._abort_session()
                    return
                self.stream = result[0]
            log('start listening')
            self._status('听…')
            self._play(self.snd_start)

        def _stop(self, flush):
            log(f'stop: flush={flush}')
            if self.state == 'listening':
                self.state = 'finishing'
                self._status('识别…')
            self._close_mic()
            if flush:
                self.worker_flush.set()
            else:
                self._finish_now()

        def _abort_session(self):
            # Esc 取消：丢弃在途语音，停止一切
            if self.segmenter:
                self.segmenter.discard = True
            self._close_mic()
            if self.state != 'idle':
                self.state = 'finishing'
                self.worker_flush.set()  # 让 worker 退出后回调 _finish_now

        def _close_mic(self):
            if self.stream is not None:
                try:
                    self.stream.stop()
                    self.stream.close()
                except Exception:
                    pass
                self.stream = None

        def _finish_now(self):
            # 所有提交都已通过 callAfter 排队完成，这里最后收尾
            self.state = 'idle'
            self.worker_stop.set()
            self._status('语音' if self.hotkey_ready else '需授权')
            self._play(self.snd_stop)

        def on_escape(self):
            if self.state == 'listening':
                log('Esc 取消')
                self._abort_session()

        # ---- 音频回调与 worker（非主线程，经 callAfter 回主线程） ----
        def _feed_wav(self, q):
            # VOICE_INPUT_TEST_WAV：按实时节奏喂文件，随后持续喂静音
            audio = read_wav_16k(TEST_WAV)
            silence = np.zeros(WIN, dtype=np.float32)
            i = 0
            while not self.worker_stop.is_set() and not self.worker_flush.is_set():
                if i + WIN <= len(audio):
                    w = audio[i:i + WIN]
                    i += WIN
                else:
                    w = silence
                q.put(w.copy())
                time.sleep(WIN / SAMPLE_RATE)

        def _audio_worker(self, seg, q):
            # 队列绑定会话：旧音频流的迟到回调喂不进本会话
            while not self.worker_stop.is_set():
                try:
                    w = q.get(timeout=0.15)
                except queue.Empty:
                    if self.worker_stop.is_set() or self.worker_flush.is_set():
                        break
                    continue
                if not seg.discard:
                    seg.feed(w)
                if self.worker_flush.is_set():
                    break
                if seg.idle_wins >= IDLE_STOP_WINS and seg.voiced == 0:
                    log('20s 无语音，自动停止')
                    AppHelper.callAfter(self._stop, True)
                    break
            # 冲刷：识别耗时期间mic仍在进队列，先把积压窗口喂完再 flush；
            # discard（Esc）则只排空
            while True:
                try:
                    w = q.get_nowait()
                except queue.Empty:
                    break
                if not seg.discard:
                    seg.feed(w)
            seg.flush()
            AppHelper.callAfter(self._finish_now)

        def _on_segment(self, audio16):
            dur = len(audio16) / SAMPLE_RATE
            t0 = time.time()
            try:
                text = clean_text(recognize(recognizer, audio16))
            except Exception as e:
                log(f'识别错误: {e}')
                return
            log(f'segment {dur:.2f}s -> asr {time.time()-t0:.2f}s')
            if DEBUG and text:
                log(f'[debug] text: {text}')
            if text:
                # focused_pid 的 AX/NSWorkspace 查询偶发阻塞（实测主线程
                # 被卡死后整个 runloop 停摆），故放到独立线程查询并限时，
                # 主线程只负责投递键盘事件
                found = []
                t = threading.Thread(
                    target=lambda: found.append(focused_pid()),
                    daemon=True)
                t.start()
                t.join(2)
                if not found:
                    log('焦点查询超时，丢弃提交')
                elif found[0] is None:
                    log('无焦点应用，丢弃提交')
                else:
                    AppHelper.callAfter(self._commit, text, found[0])

        def _commit(self, text, pid):
            # 主线程：合成键盘事件注入到当前焦点应用
            log(f'commit -> pid={pid}')
            inject_text(text, pid)

    def _valid_pid(pid):
        # 剔除自身与 loginwindow：远程桌面会话里 AX/frontmost 都会错报它
        if not pid or int(pid) == os.getpid():
            return False
        ra = NSRunningApplication.runningApplicationWithProcessIdentifier_(
            int(pid))
        # universalAccessAuthWarn（授权弹窗）在 LaunchServices 里查无记录，
        # 解析不出应用记录的 pid 一律剔除
        if ra is None:
            return False
        # loginwindow 与授权弹窗都不是合法的提交目标；注意不能用
        # activationPolicy 过滤——远程桌面会话里普通应用也会误报为 Prohibited
        blocked = {'com.apple.loginwindow', 'loginwindow',
                   'com.apple.accessibility.universalAccessAuthWarn',
                   'universalAccessAuthWarn'}
        if blocked & {ra.bundleIdentifier(), ra.localizedName()}:
            return False
        return True

    def focused_pid():
        # AX / NSWorkspace 在正常 Mac 上是权威答案。远程桌面会话里它们会
        # 错报 loginwindow 或其它常驻应用，故取屏幕窗口层级列表
        # （front-to-back，第一个普通窗口的属主）做交叉验证：AX 答案与
        # 最顶层普通窗口一致才采信，否则信物理层级顺序
        ax_pid = None
        if AXUIElementCreateSystemWide is not None:
            syswide = AXUIElementCreateSystemWide()
            err, ref = AXUIElementCopyAttributeValue(
                syswide, 'AXFocusedApplication', None)
            if err == 0 and ref is not None:
                err, pid = AXUIElementGetPid(ref, None)
                if err == 0 and _valid_pid(pid):
                    ax_pid = int(pid)
        wl_pid = None
        wl = Quartz.CGWindowListCopyWindowInfo(
            Quartz.kCGWindowListOptionOnScreenOnly |
            Quartz.kCGWindowListExcludeDesktopElements,
            Quartz.kCGNullWindowID)
        for w in wl:
            if (w.get('kCGWindowLayer', -1) == 0
                    and w.get('kCGWindowOwnerName') != 'WindowManager'
                    and _valid_pid(w.get('kCGWindowOwnerPID'))):
                wl_pid = int(w['kCGWindowOwnerPID'])
                break
        front_pid = None
        front = NSWorkspace.sharedWorkspace().frontmostApplication()
        if front is not None and _valid_pid(front.processIdentifier()):
            front_pid = int(front.processIdentifier())
        if DEBUG:
            log(f'[debug] focus ax={ax_pid} wl={wl_pid} front={front_pid}')
        if ax_pid is not None and (wl_pid is None or wl_pid == ax_pid):
            return ax_pid
        if wl_pid is not None:
            return wl_pid
        if front_pid is not None:
            return front_pid
        return ax_pid

    def inject_text(text, pid):
        # CGEventKeyboardSetUnicodeString 单次上限 20 个 UTF-16 码元
        buf, units = '', 0
        for ch in text:
            u = len(ch.encode('utf-16-le')) // 2
            if units + u > 20:
                _post_text(buf, pid)
                buf, units = '', 0
            buf += ch
            units += u
        if buf:
            _post_text(buf, pid)

    def _post_text(s, pid):
        # 注意：实测 kCGHIDEventTap 投递的键盘事件能过事件监听但到不了
        # 焦点应用，须按 pid 直接投递
        units = len(s.encode('utf-16-le')) // 2
        for down in (True, False):
            ev = Quartz.CGEventCreateKeyboardEvent(None, 0, down)
            Quartz.CGEventKeyboardSetUnicodeString(ev, units, s)
            Quartz.CGEventSetFlags(ev, 0)
            Quartz.CGEventPostToPid(pid, ev)

    app = App()

    # ---- Cmd+Z / Esc 事件监听 ----
    tap_holder = {}

    def tap_cb(proxy, event_type, event, refcon):
        if event_type in (Quartz.kCGEventTapDisabledByTimeout,
                          Quartz.kCGEventTapDisabledByUserInput):
            log(f'event tap disabled (type={event_type}), re-enabling')
            tap = tap_holder.get('tap')
            if tap is not None:
                Quartz.CGEventTapEnable(tap, True)
            return event
        keycode = Quartz.CGEventGetIntegerValueField(
            event, Quartz.kCGKeyboardEventKeycode)
        flags = Quartz.CGEventGetFlags(event)
        cmd = bool(flags & Quartz.kCGEventFlagMaskCommand)
        plain_cmd = cmd and not (flags & OTHER_MODS)
        if event_type == Quartz.kCGEventKeyDown:
            if keycode == KEY_Z and plain_cmd:
                if Quartz.CGEventGetIntegerValueField(
                        event, Quartz.kCGKeyboardEventAutorepeat):
                    return None  # 吞掉自动重复
                if DEBUG:
                    log('[debug] Cmd+Z')
                AppHelper.callAfter(app.toggle)
                return None      # 吞掉，避免焦点应用触发撤销
            if keycode == KEY_ESC and app.state == 'listening':
                AppHelper.callAfter(app.on_escape)
                return None      # 听写中吞掉 Esc，仅取消听写
        elif event_type == Quartz.kCGEventKeyUp:
            if keycode == KEY_Z and plain_cmd:
                return None      # 配对吞掉 Cmd+Z 的抬起
        return event

    mask = (Quartz.CGEventMaskBit(Quartz.kCGEventKeyDown) |
            Quartz.CGEventMaskBit(Quartz.kCGEventKeyUp))

    def setup_tap():
        tap = Quartz.CGEventTapCreate(
            Quartz.kCGSessionEventTap, Quartz.kCGHeadInsertEventTap,
            Quartz.kCGEventTapOptionDefault, mask, tap_cb, None)
        if tap is None:
            return False
        tap_holder['tap'] = tap
        src = Quartz.CFMachPortCreateRunLoopSource(None, tap, 0)
        Quartz.CFRunLoopAddSource(Quartz.CFRunLoopGetCurrent(), src,
                                  Quartz.kCFRunLoopCommonModes)
        Quartz.CGEventTapEnable(tap, True)
        return True

    # ---- NSApplication + 状态栏图标（无 Dock 图标） ----
    nsapp = NSApplication.sharedApplication()
    nsapp.setActivationPolicy_(NSApplicationActivationPolicyAccessory)
    item = NSStatusBar.systemStatusBar().statusItemWithLength_(
        NSVariableStatusItemLength)
    menu = NSMenu.alloc().init()
    settings_item = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
        '打开隐私设置', 'openSettings:', '')
    menu.addItem_(settings_item)
    menu.addItem_(NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
        '退出', 'terminate:', ''))
    item.setMenu_(menu)
    app.status_item = item

    # ---- 权限检查：缺失时弹系统授权框，服务降级运行而不是退出 ----
    real_py = os.path.realpath(sys.executable)
    ax_ok = None
    if AXIsProcessTrustedWithOptions is not None:
        ax_ok = AXIsProcessTrustedWithOptions(
            {kAXTrustedCheckOptionPrompt: True})
    listen_ok = Quartz.CGPreflightListenEventAccess()
    if not listen_ok:
        Quartz.CGRequestListenEventAccess()
    if ax_ok is not True or not listen_ok:
        log(f'权限缺失: accessibility={ax_ok} listen_event={listen_ok}; '
            f'请给 {real_py} 授予 辅助功能+输入监控（+麦克风），'
            '授权后若热键无反应需重启服务')

    def mark_ready():
        app.hotkey_ready = True
        app._status('语音')
        log('hotkey ready')

    if setup_tap() and Quartz.CGPreflightListenEventAccess():
        mark_ready()
    else:
        app._status('需授权')

    # NSApp.run() 阻塞主线程时 Python 信号回调得不到执行机会，
    # 用标志位 + 主线程定时器轮询来中转 SIGUSR1；同一定时器兼做
    # 事件监听的重试（每 3s 一次，授权后即建，无需重启服务）
    sigusr1_pending = [False]
    signal.signal(signal.SIGUSR1, lambda *_: sigusr1_pending.__setitem__(0, True))
    ticks = [0]

    class Helper(NSObject):
        def tick_(self, timer):
            if sigusr1_pending[0]:
                sigusr1_pending[0] = False
                app.toggle()
            ticks[0] += 1
            if not app.hotkey_ready and ticks[0] % 15 == 0:
                if 'tap' not in tap_holder:
                    setup_tap()
                if ('tap' in tap_holder
                        and Quartz.CGPreflightListenEventAccess()):
                    mark_ready()

        def openSettings_(self, sender):
            NSWorkspace.sharedWorkspace().openURL_(NSURL.URLWithString_(
                'x-apple.systempreferences:'
                'com.apple.preference.security?Privacy_ListenEvent'))

    helper = Helper.alloc().init()
    settings_item.setTarget_(helper)
    NSTimer.scheduledTimerWithTimeInterval_target_selector_userInfo_repeats_(
        0.2, helper, 'tick:', None, True)

    # 排障用：SIGUSR2 把各线程栈打到日志（faulthandler 在信号上下文
    # 直接输出，主线程被卡死时也能用）
    import faulthandler
    faulthandler.register(signal.SIGUSR2)

    log('ready (Cmd+Z / SIGUSR1 toggle)')
    AppHelper.runEventLoop()
    return 0


def run_service():
    return run_service_macos() if IS_DARWIN else run_service_linux()


if __name__ == '__main__':
    if len(sys.argv) >= 3 and sys.argv[1] == '--selftest':
        sys.exit(selftest(sys.argv[2]))
    sys.exit(run_service())
